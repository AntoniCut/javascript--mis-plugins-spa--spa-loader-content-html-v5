# ==============================================================
#  systemd — javascript-node
#  API Node de producción de javascript.antonydev.tech
#  --------------------------------------------------------------
#  - Corre el runtime de api/ desde /opt/javascript-node-api,
#    fuera del web root, como www-data.
#  - El código y el .env llegan con deploy.sh; esta unit solo
#    arranca el proceso y lo reinicia si falla.
#  - Los logs van a journald: journalctl -u javascript-node -f
# ==============================================================

[Unit]
Description=Node API for javascript.antonydev.tech
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/javascript-node-api
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

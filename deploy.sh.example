#!/usr/bin/env bash
set -euo pipefail

# Copia este archivo y configúralo:
#   cp deploy.sh.example deploy.sh
#   chmod +x deploy.sh
#
# deploy.sh está en .gitignore (contiene IP/rutas de tu VPS).

# ==== Configuración ====
VPS_USER="TU_USUARIO"             # p. ej. root
VPS_HOST="TU_IP_O_DOMINIO"        # IP pública del VPS o dominio
VPS_PORT="22"                     # cambia si usas otro puerto SSH
REMOTE_PATH="/var/www/TU_DOMINIO/mis-plugins-spa/spa-loader-content-html-v5"  # ruta en el VPS servida por nginx
REMOTE_API_PATH="/opt/javascript-node-api"  # runtime Node fuera del web root
API_SERVICE="javascript-node"     # unit systemd del API
LOCAL_BUILD_DIR="dist"            # carpeta que genera Gulp/tu build

# ==== Build ====
echo "==> Generando build..."
pnpm run build

if [ ! -d "$LOCAL_BUILD_DIR" ]; then
  echo "Error: no existe la carpeta '$LOCAL_BUILD_DIR'. Revisa LOCAL_BUILD_DIR."
  exit 1
fi

# ==== Deploy ====
echo "==> Subiendo al VPS ($VPS_HOST)..."
# --delete borra en remoto lo que no está en dist/. Hay que proteger .env:
# si no, PHP cae a DB_USER=root y MySQL responde Access denied.
rsync -avz --delete \
  -e "ssh -p $VPS_PORT" \
  --exclude 'node_modules' \
  --exclude '.git' \
  --exclude '.DS_Store' \
  --exclude '.env' \
  --exclude '.env.*' \
  --filter 'P .env' \
  --filter 'P .env.*' \
  "$LOCAL_BUILD_DIR"/ \
  "$VPS_USER@$VPS_HOST:$REMOTE_PATH"

if [ -f .env.production ]; then
  echo "==> Subiendo .env de produccion..."
  # --chown=root:www-data: PHP-FPM corre como www-data y debe poder leerlo.
  # Requiere VPS_USER=root; sin esto, -a preserva el dueño local y PHP no lee el .env.
  rsync -avz --chmod=F640 --chown=root:www-data \
    -e "ssh -p $VPS_PORT" \
    .env.production \
    "$VPS_USER@$VPS_HOST:$REMOTE_PATH/.env"
else
  echo "Aviso: no existe .env.production; el .env remoto no se actualiza."
fi

# ==== Deploy del API Node ====
echo "==> Subiendo api/ a $REMOTE_API_PATH..."
# --delete borra en remoto lo que no está en api/. Se protegen node_modules
# y el .env del API, que se sube aparte con permisos root:www-data.
rsync -avz --delete \
  -e "ssh -p $VPS_PORT" \
  --exclude 'node_modules' \
  --exclude '.env' \
  --filter 'P .env' \
  api/ \
  "$VPS_USER@$VPS_HOST:$REMOTE_API_PATH"

echo "==> Instalando dependencias de producción del API..."
ssh -p "$VPS_PORT" "$VPS_USER@$VPS_HOST" "node -v && cd $REMOTE_API_PATH && pnpm install --prod"

if [ -f .env.production ]; then
  echo "==> Subiendo .env del API..."
  rsync -avz --chmod=F640 --chown=root:www-data \
    -e "ssh -p $VPS_PORT" \
    .env.production \
    "$VPS_USER@$VPS_HOST:$REMOTE_API_PATH/.env"
else
  echo "Aviso: no existe .env.production; el .env del API no se actualiza."
fi

echo "==> Reiniciando el API Node..."
ssh -p "$VPS_PORT" "$VPS_USER@$VPS_HOST" "systemctl restart $API_SERVICE"

echo "==> Deploy completado."

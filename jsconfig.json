{
    "compilerOptions": {
        "checkJs": true,
        "noImplicitAny": true,
        "strict": true,
        "module": "ESNext",
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "moduleResolution": "bundler"
    },
    "include": [
        "types/**/*.d.js",
        "types/**/*.d.ts",
        "src/**/*.js",
        "server/**/*.js",
        "*.js"
    ],
    "exclude": [
        "node_modules"
    ]
}

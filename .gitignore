.env
.env.*
!.env.example
!.env.production.example

# carpeta de la app
app/

# Carpeta de distribución / compilados
dist/

# Sistema y editor (opcional, recomendable)
.DS_Store
Thumbs.db
.vscode/

# Workflow de prompts
workflows/

# Deploy local (IP y rutas del VPS)
deploy.sh

# Atl (OpenCode)
.atl/

# Playwright MCP (capturas y logs de sesión)
.playwright-mcp/

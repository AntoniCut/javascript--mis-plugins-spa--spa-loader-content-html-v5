# Puertos de partida de los servidores locales.
# Si el puerto está ocupado (otro proyecto), se prueba el siguiente: +1, +2, ... hasta 20 intentos.
DEV_SERVER_PORT=3000
PREVIEW_SERVER_PORT=4173

# Base pública del sitio (empieza por /, sin / final)
SITE_BASE=/mis-plugins-spa/spa-loader-content-html-v5

# MySQL local (Docker). El contenedor publica MYSQL_PORT en el host.
# MYSQL_ROOT_PASSWORD y MYSQL_PASSWORD son obligatorios para docker compose;
# rellenalos en .env con valores reales (este archivo es solo la plantilla).
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=javascript_user
MYSQL_PASSWORD=
MYSQL_DATABASE=javascript_mis_plugins_spa

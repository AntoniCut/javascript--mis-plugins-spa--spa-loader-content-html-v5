# ==============================================================
#  .env.production.example — plantilla del .env de producción
#  --------------------------------------------------------------
#  - Copiar a .env.production (ignorado por git) y completar.
#  - Se sube a dos destinos: el web root de PHP y
#    /opt/javascript-node-api/.env, con F640 root:www-data.
#  - No guardar credenciales reales en este archivo.
#  - SITE_BASE no va acá: se usa solo en el build local (.env).
# ==============================================================

# API Node — defaults si se omiten: 127.0.0.1:3100
API_HOST=127.0.0.1
API_PORT=3100

# MySQL — lo leen PHP (src/services/) y Node (api/).
# OJO: en local el puerto es 3308 (docker/mysql); en el VPS va el puerto real.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=javascript_user
MYSQL_PASSWORD=
MYSQL_DATABASE=javascript_mis_plugins_spa